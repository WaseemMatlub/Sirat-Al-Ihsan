"ar":"اَيَّانَ"},{"ar":"عَشِيَّةً"},{"ar":"لَعَلَّهٗ"},{"ar":"يَذَّكَّرُ"}],"size":"lg"}]},{"n":15,"t":"Shaddah with sukun","ar":"التَّشْدِيدُ مَعَ السُّكُونِ","intro":["Words that have both a shaddah and a sukun."],"blocks":[{"type":"grid","items":[{"ar":"اِنَّهُمۡ"},{"ar":"لِلۡمُتَّقِيۡنَ"},{"ar":"يَتَكَلَّمُوۡنَ"},{"ar":"قَدَّمَتۡ"},{"ar":"فَالۡمُدَبِّرٰتِ"},{"ar":"كَاَنَّهُمۡ"},{"ar":"كُوِّرَتۡ"},{"ar":"سُيِّرَتۡ"},{"ar":"عُطِّلَتۡ"},{"ar":"سُجِّرَتۡ"},{"ar":"زُوِّجَتۡ"},{"ar":"سُعِّرَتۡ"},{"ar":"وَالَّيۡلِ"},{"ar":"فُجِّرَتۡ"},{"ar":"وَاَخَّرَتۡ"},{"ar":"تُكَذِّبُوۡنَ"},{"ar":"اَنَّهُمۡ"},{"ar":"سِجِّيۡنٍ"},{"ar":"سِجِّيۡنٌ"},{"ar":"يُكَذِّبُوۡنَ"},{"ar":"عِلِّيِّيۡنَ"},{"ar":"عِلِّيُّوۡنَ"},{"ar":"وَحُقَّتۡ"},{"ar":"مُدَّتۡ"},{"ar":"وَتَخَلَّتۡ"},{"ar":"لَتَرۡكَبُنَّ"},{"ar":"فَبَشِّرۡهُمۡ"},{"ar":"وَالَّذِيۡ"},{"ar":"فَذَكِّرۡ"},{"ar":"قَدَّمۡتُ"},{"ar":"جَنَّتِيۡ"},{"ar":"وَالَّذِيۡنَ"},{"ar":"كَذَّبَتۡ"},{"ar":"فَكَذَّبُوۡهُ"},{"ar":"رَبُّهُمۡ"},{"ar":"فَحَدِّثۡ"}],"size":"lg"}]},{"n":16,"t":"Shaddah after shaddah","ar":"التَّشْدِيدُ مَعَ التَّشْدِيدِ","intro":["Two shaddahs in one word, or one after another across words, as at the end of al-Fatihah. Press on each."],"blocks":[{"type":"grid","items":[{"ar":"الضَّآلِّيۡنَ"},{"ar":"وَّهَّاجًا"},{"ar":"وَّجَنّٰتٍ"},{"ar":"وَّسُيِّرَتِ"},{"ar":"لِّلطّٰغِيۡنَ"},{"ar":"وَّغَسَّاقًا"},{"ar":"وَّكَذَّبُوۡا"},{"ar":"رَّبِّكَ"},{"ar":"رَّبِّ"},{"ar":"وَّالنّٰشِطٰتِ"},{"ar":"وَّالسّٰبِحٰتِ"},{"ar":"الطَّآمَّةُ"},{"ar":"يَزَّكّٰ٘ي"},{"ar":"يَذَّكَّرُ"},{"ar":"يَزَّكّٰي"},{"ar":"مُّكَرَّمَةٍ"},{"ar":"مُّطَهَّرَةٍۭ"},{"ar":"وَّاَبًّا"},{"ar":"الصَّآخَّةُ"},{"ar":"وَّاِنَّ"},{"ar":"لِّلّٰهِ"},{"ar":"لِّلۡمُطَفِّفِيۡنَ"},{"ar":"لِّلۡمُكَذِّبِيۡنَ"},{"ar":"رَّبِّهِمۡ"},{"ar":"عِلِّيِّيۡنَ"},{"ar":"عِلِّيُّوۡنَ"},{"ar":"وَّاللّٰهُ"},{"ar":"لَّمَّا"},{"ar":"سَيَذَّكَّرُ"},{"ar":"وَّزَرَابِيُّ"}],"size":"lg"}]},{"n":17,"t":"Shaddah with madd letters","ar":"التَّشْدِيدُ مَعَ حُرُوفِ الْمَدِّ","intro":["A madd letter followed by a shaddah is stretched for six counts: الضَّآلِّیْنَ, دَآبَّۃٍ."],"blocks":[{"type":"grid","items":[{"ar":"الضَّآلِّيۡنَ"},{"ar":"السَّمَآءُ"},{"ar":"اِنَّا٘"},{"ar":"الطَّآمَّةُ"},{"ar":"اِنَّمَا٘"},{"ar":"وَتَوَلّٰ٘ي"},{"ar":"يَزَّكّٰ٘ي"},{"ar":"كَلَّا٘"},{"ar":"الصَّآخَّةُ"},{"ar":"اِلَّا٘"},{"ar":"يٰ٘اَيُّهَا"},{"ar":"لَضَآلُّوۡنَ"},{"ar":"وَالسَّمَآءِ"},{"ar":"وَالتَّرَآئِبِ"},{"ar":"السَّرَآئِرُ"},{"ar":"وَالَّذِيۡ٘"},{"ar":"السَّمَآءِ"},{"ar":"رَبِّيۡ٘"},{"ar":"وَاَمَّا٘"},{"ar":"تَحٰٓضُّوۡنَ"},{"ar":"يٰ٘اَيَّتُهَا"},{"ar":"ضَآلًّا"},{"ar":"السَّآئِلَ"},{"ar":"الَّذِيۡ٘"},{"ar":"الشِّتَآءِ"}],"size":"lg"}]},{"n":18,"t":"Noon sakin, tanween and mim sakin","ar":"أَحْكَامُ النُّونِ السَّاكِنَةِ وَالتَّنْوِينِ وَالْمِيمِ","intro":["Izhar: noon sakin or tanween before a throat letter (ء ه ع ح غ خ) is read clearly, with no ghunnah.","Idgham: before ی ر م ل و ن it merges into the next letter. With ی ن م و there is ghunnah; with ل ر there is none.","Iqlab: before ب it turns into a mim, with ghunnah (shown by a small mim).","Ikhfa': before the other fifteen letters it is hidden, read with ghunnah for two counts.","Mim sakin before ب is hidden with ghunnah (ikhfa' shafawi); before م it merges with ghunnah; before any other letter it is read clearly.","The lam of اللّٰہ is heavy after a fatha or dammah, and light after a kasra: قَالَ اللّٰہُ, بِسْمِ اللّٰہِ."],"blocks":[{"type":"p","text":"Ikhfa' inside a word (noon sakin before one of the fifteen letters):"},{"type":"grid","items":[{"ar":"وَّاَنۡزَلۡنَا"},{"ar":"يُنۡفَخُ"},{"ar":"اَنۡذَرۡنٰكُمۡ"},{"ar":"يَنۡظُرُ"},{"ar":"كُنۡتُ"},{"ar":"ءَاَنۡتُمۡ"},{"ar":"الۡاِنۡسَانُ"},{"ar":"اَنۡتَ"},{"ar":"مُنۡتَهٰىهَا"},{"ar":"مُنۡذِرُ"},{"ar":"فَتَنۡفَعَهُ"},{"ar":"فَاَنۡتَ"}],"size":"lg"},{"type":"p","text":"Izhar inside a word (noon sakin before a throat letter):"},{"type":"grid","items":[{"ar":"اَنۡعَمۡتَ"},{"ar":"مِنۡهُ"},{"ar":"مِنۡهَا"},{"ar":"وَلِاَنۡعَامِكُمۡ"},{"ar":"عَنۡهُ"},{"ar":"مِّنۡهُمۡ"},{"ar":"عَنۡهَا"},{"ar":"مِنۡهُمۡ"}],"size":"lg"},{"type":"p","text":"Iqlab (noon sakin before ب):"},{"type":"grid","items":[{"ar":"فَاَنۭۡبَتۡنَا"},{"ar":"ذَنۭۡبٍ"},{"ar":"انۭۡبَعَثَ"},{"ar":"بِذَنۭۡبِهِمۡ"},{"ar":"لَيُنۭۡبَذَنَّ"}],"size":"lg"}]}]}