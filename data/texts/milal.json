ة","n":4},{"h":"المسألة الحادية عشرة: في كون الحركات سرمدية، وأن الحوادث لم تزل","lvl":4,"parent":"الباب الخامس: الفلاسفة","n":5},{"h":"المسألة الثانية عشرة: في كيفية تركب العناصر","lvl":4,"parent":"الباب الخامس: الفلاسفة","n":6},{"h":"المسألة الرابعة عشرة: في النفس الإنسانية الناطقة، واتصالها بالبدن","lvl":4,"parent":"الباب الخامس: الفلاسفة","n":3},{"h":"المسألة الخامسة عشرة: في وجه اتصالها بالبدن، ووقت اتصالها","lvl":4,"parent":"الباب الخامس: الفلاسفة","n":4},{"h":"المسألة السادسة عشرة: في بقائها بعد البدن، وسعادتها في العالم العقلي","lvl":4,"parent":"الباب الخامس: الفلاسفة","n":13},{"h":"حكم الإسكندر الرومي","lvl":3,"parent":"الباب الخامس: الفلاسفة","n":43},{"h":"حكم ديوجانس الكلبي","lvl":3,"parent":"الباب الخامس: الفلاسفة","n":25},{"h":"حكم الشيخ اليوناني","lvl":3,"parent":"الباب الخامس: الفلاسفة","n":19},{"h":"حكم ثاوفرسطيس","lvl":3,"parent":"الباب الخامس: الفلاسفة","n":10},{"h":"شبه برفلس في قدم العالم","lvl":3,"parent":"الباب الخامس: الفلاسفة","n":22},{"h":"رأي ثامسطيوس","lvl":3,"parent":"الباب الخامس: الفلاسفة","n":4},{"h":"رأي الإسكندر الأفروديسي","lvl":3,"parent":"الباب الخامس: الفلاسفة","n":6},{"h":"رأي فرفوريوس","lvl":3,"parent":"الباب الخامس: الفلاسفة","n":7},{"h":"الفصل الرابع: المتأخرون في الإسلام","lvl":2,"parent":"الباب الخامس: الفلاسفة","n":2},{"h":"ابن سينا: كلامه في المنطق (1/4)","lvl":3,"parent":"الباب الخامس: الفلاسفة","n":7},{"h":"ابن سينا: كلامه في المنطق (2/4)","lvl":3,"parent":"الباب الخامس: الفلاسفة","n":23},{"h":"ابن سينا: كلامه في المنطق (3/4)","lvl":3,"parent":"الباب الخامس: الفلاسفة","n":16},{"h":"ابن سينا: كلامه في المنطق (4/4)","lvl":3,"parent":"الباب الخامس: الفلاسفة","n":12},{"h":"في الإلهيات","lvl":3,"parent":"الباب الخامس: الفلاسفة","n":1},{"h":"المسألة الأولى منها: في موضوع هذا العلم، وجملة ما ينظر فيه، والتنبيه على الوجود وأقسامه","lvl":4,"parent":"الباب الخامس: الفلاسفة","n":1},{"h":"المسألة الثانية: في تحقيق الجوهر الجسماني وما يتركب منه، وأن المادة الجسمانية لا تتعرى عن الصورة، وأن الصورة متقدمة على المادة في مرتبة الوجود","lvl":4,"parent":"الباب الخامس: الفلاسفة","n":5},{"h":"المسألة الثالثة: في أقسام العلل، وأحوالها، وفي القوة والفعل، وفي إثبات الكيفيات في الكمية، وإن الكيفيات أعراض لا جواهر","lvl":4,"parent":"الباب الخامس: الفلاسفة","n":3},{"h":"المسألة الرابعة: في المتقدم، والمتأخر، والقديم، والحادث، وإثبات المادة لكل متكون","lvl":4,"parent":"الباب الخامس: الفلاسفة","n":1},{"h":"المسألة الخامسة: في الكلي، والواحد، ولواحقهما","lvl":4,"parent":"الباب الخامس: الفلاسفة","n":2},{"h":"المسألة السادسة: في تعريف واجب الوجود بذاته، وأنه لا يكون بذاته وبغيره معا، وأنه لا كثرة في ذاته بوجه، وأنه خير محض. وحق محض. وأنه واحد من وجوه شتى، ولا يجوز أن يكون اثنان واجبي الوجود، وفي إثبات واجب الوجود بذاته","lvl":4,"parent":"الباب الخامس: الفلاسفة","n":3},{"h":"المسألة السابعة: في أن واجب الوجود عقل، وعاقل، ومعقول، وأنه يعقل ذاته والأشياء، وصفاته الإيجابية والسلبية لا توجب كثرة في ذاته، وكيفية صدور الأفعال عنه","lvl":4,"parent":"الباب الخامس: الفلاسفة","n":1},{"h":"المسألة الثامنة: في أن الواحد لا يصدر عنه إلا واحد، وفي ترتيب وجود العقول والنفوس والأجرام العلوية، وأن المحرك القريب للسماويات نفس، والمبدأ الأعلى عقل، وحال تكون الأسطقسات عن العلل (1/2)","lvl":4,"parent":"الباب الخامس: الفلاسفة","n":3},{"h":"المسألة الثامنة: في أن الواحد لا يصدر عنه إلا واحد، وفي ترتيب وجود العقول والنفوس والأجرام العلوية، وأن المحرك القريب للسماويات نفس، والمبدأ الأعلى عقل، وحال تكون الأسطقسات عن العلل (2/2)","lvl":4,"parent":"الباب الخامس: الفلاسفة","n":3},{"h":"المسألة التاسعة: في العناية الأزلية، وبيان دخول الشر في القضاء","lvl":4,"parent":"الباب الخامس: الفلاسفة","n":1},{"h":"المسألة العاشرة: في المعاد، وإثبات سعادات دائمة للنفوس، وإشارة إلى النبوة، وكيفية الوحي والإلهام","lvl":4,"parent":"الباب الخامس: الفلاسفة","n":9},{"h":"في الطبيعيات","lvl":3,"parent":"الباب الخامس: الفلاسفة","n":2},{"h":"المقالة الأولى: في لواحق الأجسام الطبيعية","lvl":4,"parent":"الباب الخامس: الفلاسفة","n":1},{"h":"أما الحركة","lvl":5,"parent":"الباب الخامس: الفلاسفة","n":1},{"h":"والسكون","lvl":5,"parent":"الباب الخامس: الفلاسفة","n":3},{"h":"الزمان","lvl":5,"parent":"الباب الخامس: الفلاسفة","n":2},{"h":"المكان","lvl":5,"parent":"الباب الخامس: الفلاسفة","n":4},{"h":"المقالة الثانية: في الأمور الطبيعية وغير الطبيعية للأجسام","lvl":4,"parent":"الباب الخامس: الفلاسفة","n":2},{"h":"المقالة الثالثة: في المركبات والآثار العلوية","lvl":4,"parent":"الباب الخامس: الفلاسفة","n":3},{"h":"المقالة الرابعة: في النفوس وقواها","lvl":4,"parent":"الباب الخامس: الفلاسفة","n":15},{"h":"المقالة الخامسة: في أن النفس الإنسانية جوهر ليس بجسم ولا قائم بجسم. وأن إدراكها قد يكون بآلات وقد يكون بذاتها بغير آلات. وأنها واحدة وقواها كثيرة، وأنها حادثة مع حدوث البدن وباقية بعد فناء البدن","lvl":4,"parent":"الباب الخامس: الفلاسفة","n":13},{"h":"المقالة السادسة: في وجه خروج العقل النظري من القوة إلى الفعل، وأحوال خاصة بالنفس الإنسانية من الرؤيا الصادقة والكاذبة، وإدراكها علم الغيب، ومشاهدتها صورا لا وجود لها من خارج تلك الوجوه، ومعنى النبوة والمعجزات وخصائصها التي تتميز بها عن المخاريق","lvl":4,"parent":"الباب الخامس: الفلاسفة","n":14},{"h":"العرب وغيرهم","lvl":3,"parent":"الباب الثالث: آراء العرب في الجاهلية","n":2},{"h":"حكم البيت العتيق","lvl":3,"parent":"الباب الخامس: الفلاسفة","n":5},{"h":"البيوت المتخذة للعبادة","lvl":3,"parent":"الباب الخامس: الفلاسفة","n":1},{"h":"واعلم أن العرب أصناف شتى","lvl":3,"parent":"الباب الخامس: الفلاسفة","n":1},{"h":"الفصل الأول: معطلة العرب","lvl":2,"parent":"الباب الخامس: الفلاسفة","n":1},{"h":"منكرو الخالق، والبعث، والإعادة","lvl":3,"parent":"الباب الخامس: الفلاسفة","n":1},{"h":"منكرو البعث، والإعادة","lvl":3,"parent":"الباب الخامس: الفلاسفة","n":1},{"h":"منكرو الرسل: عباد الأصنام","lvl":3,"parent":"الباب الخامس: الفلاسفة","n":1},{"h":"شبهات العرب","lvl":3,"parent":"الباب الخامس: الفلاسفة","n":10},{"h":"أصنام العرب وميولهم","lvl":3,"parent":"الباب الخامس: الفلاسفة","n":8},{"h":"علومهم","lvl":3,"parent":"الفصل الثاني: المحصلة من العرب","n":30},{"h":"معتقداتهم","lvl":3,"parent":"الباب الخامس: الفلاسفة","n":50},{"h":"تقاليد العرب التي أقرها الإسلام، وبعض عاداتهم","lvl":3,"parent":"الباب الخامس: الف